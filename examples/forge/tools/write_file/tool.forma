# Forge tool protocol: args are tool_input, tool_payload, and context JSON.

f main() -> Int
    invocation := args()
    if invocation.len() != 3
        print("TOOL_ERROR: expected input, payload, and context")
    else
        m json_parse(str(invocation[2]))
            Err(error) -> print("TOOL_ERROR: invalid context: " + error)
            Ok(context) ->
                root := m json_get_str(context, "workspace_root")
                    Some(value) -> value
                    None -> ""
                m path_resolve_within(root, str(invocation[0]))
                    Err(_) ->
                        print("TOOL_ERROR: path must remain inside workspace_root")
                    Ok(path) ->
                        m file_write(path, str(invocation[1]))
                            Ok(_) -> print("TOOL_OK: wrote " + path)
                            Err(_) -> print("TOOL_ERROR: write failed")
    0
