# FORMA Standard Library - Vec Module
# Generic vector operations using recursion (no closures needed)

# ============================================================
# Vec[T] - Generic wrapper around arrays
# ============================================================

pub s Vec[T]
    data: [T]

# Create empty vector
pub f vec_empty[T]() -> Vec[T]
    Vec { data: [] }

# Create vector from array
pub f vec_from[T](arr: [T]) -> Vec[T]
    Vec { data: arr }

# Create single-element vector
pub f vec_single[T](item: T) -> Vec[T]
    Vec { data: vec_push([], item) }

# Get length
pub f vec_length[T](v: Vec[T]) -> Int
    vec_len(v.data)

# Check if empty
pub f vec_is_empty[T](v: Vec[T]) -> Bool
    vec_len(v.data) == 0

# Get element at index
pub f vec_at[T](v: Vec[T], idx: Int) -> T?
    vec_get(v.data, idx)

# Get first element
pub f vec_head[T](v: Vec[T]) -> T?
    vec_first(v.data)

# Get last element
pub f vec_last_elem[T](v: Vec[T]) -> T?
    vec_last(v.data)

# Get all elements except first (tail of list)
pub f vec_tail[T](v: Vec[T]) -> Vec[T]
    Vec { data: vec_slice(v.data, 1, vec_len(v.data)) }

# Get all elements except last (init of list)
pub f vec_init[T](v: Vec[T]) -> Vec[T]
    len := vec_len(v.data)
    if len == 0 then Vec { data: [] }
    else Vec { data: vec_slice(v.data, 0, len - 1) }

# Append element (returns new vec)
pub f vec_append[T](v: Vec[T], item: T) -> Vec[T]
    Vec { data: vec_push(v.data, item) }

# Remove last element
pub f vec_remove_last[T](v: Vec[T]) -> (Vec[T], T?)
    (new_data, removed) := vec_pop(v.data)
    (Vec { data: new_data }, removed)

# Update element at index
pub f vec_update[T](v: Vec[T], idx: Int, item: T) -> Vec[T]
    Vec { data: vec_set(v.data, idx, item) }

# Concatenate two vecs
pub f vec_join[T](v1: Vec[T], v2: Vec[T]) -> Vec[T]
    Vec { data: vec_concat(v1.data, v2.data) }

# Slice
pub f vec_range[T](v: Vec[T], start: Int, end: Int) -> Vec[T]
    Vec { data: vec_slice(v.data, start, end) }

# Reverse
pub f vec_reversed[T](v: Vec[T]) -> Vec[T]
    Vec { data: vec_reverse(v.data) }

# To array
pub f vec_to_array[T](v: Vec[T]) -> [T]
    v.data

# ============================================================
# Int-specific operations (recursive, no closures)
# ============================================================

# Sum all elements
pub f int_vec_sum(arr: [Int]) -> Int
    int_sum_loop(arr, 0, 0)

pub f int_sum_loop(arr: [Int], idx: Int, acc: Int) -> Int
    if idx >= vec_len(arr) then acc
    else
        m vec_get(arr, idx)
            Some(x) -> int_sum_loop(arr, idx + 1, acc + x)
            None -> acc

# Product of all elements
pub f int_vec_product(arr: [Int]) -> Int
    int_product_loop(arr, 0, 1)

pub f int_product_loop(arr: [Int], idx: Int, acc: Int) -> Int
    if idx >= vec_len(arr) then acc
    else
        m vec_get(arr, idx)
            Some(x) -> int_product_loop(arr, idx + 1, acc * x)
            None -> acc

# Find minimum
pub f int_vec_min(arr: [Int]) -> Int?
    if vec_len(arr) == 0 then None
    else
        m vec_first(arr)
            Some(first) -> Some(int_min_loop(arr, 1, first))
            None -> None

pub f int_min_loop(arr: [Int], idx: Int, current: Int) -> Int
    if idx >= vec_len(arr) then current
    else
        m vec_get(arr, idx)
            Some(x) ->
                new_min := if x < current then x else current
                int_min_loop(arr, idx + 1, new_min)
            None -> current

# Find maximum
pub f int_vec_max(arr: [Int]) -> Int?
    if vec_len(arr) == 0 then None
    else
        m vec_first(arr)
            Some(first) -> Some(int_max_loop(arr, 1, first))
            None -> None

pub f int_max_loop(arr: [Int], idx: Int, current: Int) -> Int
    if idx >= vec_len(arr) then current
    else
        m vec_get(arr, idx)
            Some(x) ->
                new_max := if x > current then x else current
                int_max_loop(arr, idx + 1, new_max)
            None -> current

# Count occurrences of value
pub f int_vec_count(arr: [Int], target: Int) -> Int
    int_count_loop(arr, 0, 0, target)

pub f int_count_loop(arr: [Int], idx: Int, count: Int, target: Int) -> Int
    if idx >= vec_len(arr) then count
    else
        m vec_get(arr, idx)
            Some(x) ->
                new_count := if x == target then count + 1 else count
                int_count_loop(arr, idx + 1, new_count, target)
            None -> count

# Check if contains value
pub f int_vec_contains(arr: [Int], target: Int) -> Bool
    int_contains_loop(arr, 0, target)

pub f int_contains_loop(arr: [Int], idx: Int, target: Int) -> Bool
    if idx >= vec_len(arr) then false
    else
        m vec_get(arr, idx)
            Some(x) -> if x == target then true else int_contains_loop(arr, idx + 1, target)
            None -> false

# Find index of value
pub f int_vec_index_of(arr: [Int], target: Int) -> Int?
    int_index_loop(arr, 0, target)

pub f int_index_loop(arr: [Int], idx: Int, target: Int) -> Int?
    if idx >= vec_len(arr) then None
    else
        m vec_get(arr, idx)
            Some(x) -> if x == target then Some(idx) else int_index_loop(arr, idx + 1, target)
            None -> None

# Check if all elements positive
pub f int_vec_all_positive(arr: [Int]) -> Bool
    int_all_pos_loop(arr, 0)

pub f int_all_pos_loop(arr: [Int], idx: Int) -> Bool
    if idx >= vec_len(arr) then true
    else
        m vec_get(arr, idx)
            Some(x) -> if x > 0 then int_all_pos_loop(arr, idx + 1) else false
            None -> true

# Check if any element negative
pub f int_vec_any_negative(arr: [Int]) -> Bool
    int_any_neg_loop(arr, 0)

pub f int_any_neg_loop(arr: [Int], idx: Int) -> Bool
    if idx >= vec_len(arr) then false
    else
        m vec_get(arr, idx)
            Some(x) -> if x < 0 then true else int_any_neg_loop(arr, idx + 1)
            None -> false

# Take first n elements
pub f int_vec_take(arr: [Int], n: Int) -> [Int]
    int_take_loop(arr, 0, n, [])

pub f int_take_loop(arr: [Int], idx: Int, n: Int, acc: [Int]) -> [Int]
    if idx >= n || idx >= vec_len(arr) then acc
    else
        m vec_get(arr, idx)
            Some(x) -> int_take_loop(arr, idx + 1, n, vec_push(acc, x))
            None -> acc

# Drop first n elements
pub f int_vec_drop(arr: [Int], n: Int) -> [Int]
    int_drop_loop(arr, 0, n, [])

pub f int_drop_loop(arr: [Int], idx: Int, n: Int, acc: [Int]) -> [Int]
    if idx >= vec_len(arr) then acc
    else if idx < n then int_drop_loop(arr, idx + 1, n, acc)
    else
        m vec_get(arr, idx)
            Some(x) -> int_drop_loop(arr, idx + 1, n, vec_push(acc, x))
            None -> acc

# ============================================================
# Builder pattern
# ============================================================

pub f vec_builder[T]() -> Vec[T]
    vec_empty()

pub f vec_add[T](v: Vec[T], item: T) -> Vec[T]
    vec_append(v, item)

pub f vec_build[T](v: Vec[T]) -> Vec[T]
    v
